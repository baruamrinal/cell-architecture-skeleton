# Local platform settings for `.\make up` / `make up` (k3d: a platform cluster plus one
# cluster per cell). Copy to .env and change the values: .env is git-ignored because it
# holds secrets. Without a .env file, these development defaults are used.

# --- Credentials ----------------------------------------------------------------------

# Admin credential for the control plane. cellctl uses it automatically from here.
ADMIN_TOKEN=dev-admin-token
# Read-only credential the router uses for route lookups.
ROUTER_TOKEN=dev-router-token
# Guards the router's per-tenant usage stats; `cellctl usage` reads it from here.
ROUTER_METRICS_TOKEN=dev-metrics-token
# One credential per seed cell: CELL_1_TOKEN for cell-1, CELL_2_TOKEN for cell-2, ...
# Cells added with `cellctl cells deploy` get generated credentials of their own.
CELL_1_TOKEN=dev-cell-1-token

# --- Cells ----------------------------------------------------------------------------

# Seed cells, each in its own k3d cluster (cellarch-<id>). Start small: one cell.
CELLS=cell-1
# Requests each cell handles at once; more get 503 cell_overloaded.
# MAX_CONCURRENT_REQUESTS=100
# Tenants per cell before fill-first moves on (75% target).
# DEFAULT_CELL_CAPACITY=4

# --- Tenants and rate limiting --------------------------------------------------------

# Default limits per tier, "<requests per second>:<burst>". Override one tenant with:
#   cellctl tenants set-limit acme --rps 200 --burst 400
# RATE_LIMIT_STANDARD=50:100
# RATE_LIMIT_PREMIUM=500:1000
# redis: all routers share one bucket per tenant (Redis runs in the platform cluster);
# memory: each router counts on its own. Routers fall back to memory if Redis is down.
# RATE_LIMIT_BACKEND=redis
# Routers sharing the traffic (memory backend: each enforces limit / replicas).
# ROUTER_REPLICAS=1

# --- Local setup ----------------------------------------------------------------------

# Your name for created_by / updated_by (default: your OS user name).
# CELLCTL_ACTOR=your-name
