# Local platform settings for `.\make up` / `make up`.
# Copy to .env and change the values: .env is git-ignored because it holds secrets.
# Without a .env file, these development defaults are used.

# Admin credential for the control plane (also used by cellctl).
ADMIN_TOKEN=dev-admin-token
# Read-only credential the router uses for route lookups.
ROUTER_TOKEN=dev-router-token
# Credentials of the cells defined in deploy/ (cells added with `cellctl cells deploy`
# get generated credentials of their own).
CELL_1_TOKEN=dev-cell-1-token
CELL_2_TOKEN=dev-cell-2-token
CELL_3_TOKEN=dev-cell-3-token

# Default data isolation for new tenants: isolated (own database in its cell) or pooled
# (shared tables). Can also be chosen per tenant: cellctl tenants create x --isolation pooled
DEFAULT_TENANT_ISOLATION=isolated

# Default rate limits per tier, "<requests per second>:<burst>". Override per tenant:
#   cellctl tenants set-limit acme --rps 200 --burst 400
RATE_LIMIT_STANDARD=50:100
RATE_LIMIT_PREMIUM=500:1000
# Number of routers sharing traffic; each enforces limit / replicas.
ROUTER_REPLICAS=1

# Extra compose files to include, comma-separated, e.g. the hand-written cell-3:
# EXTRA_COMPOSE_FILES=deploy/cell-3.override.yml
EXTRA_COMPOSE_FILES=

# Your name for created_by / updated_by (default: your OS user name).
# CELLCTL_ACTOR=your-name
