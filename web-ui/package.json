{
  "name": "cellarch-web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The tenant web UI: a tenant's users and orders, through mgr's GraphQL API (docs/plan.md §2.4)",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "graphql": "17.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "urql": "5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
